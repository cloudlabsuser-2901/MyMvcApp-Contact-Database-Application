@model IEnumerable<MyMvcApp.Models.User>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create", "User")
</p>

@using (Html.BeginForm("Index", "User", FormMethod.Get))
{
    <div class="form-group">
        <label for="searchString">Search by Name or Email:</label>
        @Html.TextBox("searchString", ViewBag.SearchString as string, new { @class = "form-control", style = "display: inline-block; width: 200px;" })
        <input type="submit" value="Search" class="btn btn-primary" />
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
        {
            <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
        }
    </div>
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>